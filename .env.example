# docker compose lee automáticamente el archivo ".env" (sin ".example")
# que esté en esta misma carpeta para sustituir ${VARIABLE} en
# docker-compose.yml. Copiar este archivo a ".env" y pegar la clave real:
#
#   cp .env.example .env
#
# ".env" es un secreto local -- no lo compartan/suban a ningún repo.

# Opcional. La usan Agente 1 (Legal, extracción de metadatos) y el
# Orquestador (barra de búsqueda del dossier en /orquestador/consultar).
# Sin ella, ambos degradan a un modo heurístico (regex / palabras clave)
# ya probado y funcional -- no es obligatoria para que el demo corra.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
