# URLs de los microservicios de los agentes (ajustar si corren en otro host/puerto)
AGENTE1_URL=http://localhost:8001/analyze/legal
AGENTE2_URL=http://localhost:8002/agente2/analizar
AGENTE3_URL=http://localhost:8003/agente3/analizar

# Para forzar el modo simulado de AGENTE_1_LEGAL (p.ej. si el servicio no
# está corriendo), dejar AGENTE1_URL vacío en lugar de borrar la línea.

AGENTE_TIMEOUT_SEGUNDOS=15

# Usado por app.py (Streamlit) para encontrar al Orquestador
ORQUESTADOR_URL=http://localhost:8080

# Opcional: dónde persiste la Memoria Transversal (ver memoria_transversal.py).
# Por defecto: orquestador/memoria_transversal.json
MEMORIA_TRANSVERSAL_PATH=

# Opcional: usada por /orquestador/consultar (barra de búsqueda del
# dossier). Sin ella, responde con un buscador heurístico por palabras
# clave en vez de Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
